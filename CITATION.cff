cff-version: 1.2.0
message: "If you use this software in a publication, please cite it as below."
type: software
title: "dsgelab: a general toolkit for solving DSGE models in Python"
abstract: >-
  Steady state, Klein/QZ first-order solution, second- and third-order perturbation, perfect foresight with expectation errors, optimal policy (Ramsey, discretion, optimal simple rules) and welfare, Kalman filtering and smoothing, Bayesian estimation, shock decompositions and forecasts, reading Dynare .mod files, and export to Dynare and MacroModelling.jl. Validated against Dynare and MacroModelling.jl.
authors:
  - family-names: "Moreira"
    given-names: "Gustavo Hoffmann"
    email: "gustavo@gakusai.net"
    # orcid: "https://orcid.org/0000-0000-0000-0000"   # fill in
version: "0.4.0"
date-released: "2026-10-11"
license: MIT
# Fill in on publication. A Zenodo DOI, obtained by linking the repository and creating a release,
# makes the citation stable, since a repository URL is not an archivable reference.
repository-code: "https://github.com/GustavoHM/dsgelab"
# doi: "10.5281/zenodo.XXXXXXX"
keywords:
  - "DSGE"
  - "perturbation"
  - "rational expectations"
  - "Python"
