    given-names: "Gustavo Hoffmann"
    email: "gustavo@gakusai.net"
    # orcid: "https://orcid.org/0000-0000-0000-0000"   # preencha
version: "0.2.0"
date-released: "2026-09-09"
license: MIT
# Preencha ao publicar. Um DOI do Zenodo, obtido ligando o repositório e criando um release,
# é o que torna a citação estável — uma URL de repositório não é uma referência arquivável.
repository-code: "https://github.com/GustavoHM/dsgelab"
# doi: "10.5281/zenodo.XXXXXXX"
keywords:
  - "DSGE"
  - "perturbation"
  - "rational expectations"
  - "Python"
