# The sdist carries the test suite. test_heutel.py reads its reference values
# from validation/, and test_mmb_prepare.py imports validation/mmb/prepare.py.
# Nothing else under validation/ is needed to test.
include CHANGELOG.md CITATION.cff LICENSE README.md
recursive-include tests *.py
include validation/heutel/reference.json
include validation/mmb/prepare.py
